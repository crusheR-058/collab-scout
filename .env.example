# Copy to .env for local runs. Never commit real values.
# Qloo: leave unset locally if you ran `qloo setup --qloo`; set it on the server.
QLOO_API_KEY=
# Bedrock: credentials come from your AWS profile locally and the instance role on EC2.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=zai.glm-5
PORT=8787
SCOUTS_PER_HOUR=8
# Saved scouts. Defaults to data/collab-scout.db beside the app; keep it outside
# anything a redeploy replaces.
DATABASE_PATH=
# Set to enable GET /api/metrics with "Authorization: Bearer <token>".
METRICS_TOKEN=
